{
  "name": "opencode-llm-vibe",
  "version": "0.1.0",
  "description": "Let the model declare its mood; render it as an animated pseudo-graphic square in the OpenCode TUI.",
  "license": "MIT",
  "author": "Evgeny Zhuravlev",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evgenyzh/opencode-llm-vibe.git"
  },
  "bugs": {
    "url": "https://github.com/evgenyzh/opencode-llm-vibe/issues"
  },
  "homepage": "https://github.com/evgenyzh/opencode-llm-vibe#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "mood",
    "vibe"
  ],
  "engines": {
    "node": ">=22",
    "opencode": ">=2.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/client": "2.2.5",
    "@opencode/plugin": "2.2.5",
    "@opencode/theme": "2.2.5",
    "@opentui/core": "0.8.2",
    "@opentui/solid": "0.8.2",
    "@types/node": "24.19.2",
    "solid-js": "1.9.18",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
